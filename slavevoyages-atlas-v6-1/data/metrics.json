{
  "schema_version":"1.1.0",
  "metrics":{
    "voyages":{"label":"Voyages","aggregation":"count","field":"voyageid","evidence":"record"},
    "embarked_observed":{"label":"Embarked captives (observed)","aggregation":"sum","field":"tslavesd","evidence":"data"},
    "embarked_imputed":{"label":"Embarked captives (imputed)","aggregation":"sum","field":"slaximp","evidence":"imputed"},
    "arrived_observed":{"label":"Disembarked captives (observed)","aggregation":"sum","field":"slaarriv","evidence":"data"},
    "arrived_imputed":{"label":"Disembarked captives (imputed)","aggregation":"sum","field":"slamimp","evidence":"imputed"},
    "loss_rate_observed":{"label":"Derived loss rate","aggregation":"derived","formula":"sum(TSLAVESD-SLAARRIV)/sum(TSLAVESD)","inputs":["tslavesd","slaarriv"],"evidence":"data"}
  }
}
